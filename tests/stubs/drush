#!/usr/bin/env bash
# Stand-in for Drush. Behaviour comes from STUB_* variables.
echo "drush $*" >> "$STUB_LOG"
case "$1" in
  status)
    if [[ "$*" == *drupal-version* ]]; then echo "${STUB_CORE:-11.2.5}"; else echo "${STUB_BOOTSTRAP-Successful}"; fi ;;
  php:eval)
    if [[ "$2" == *CONNECTOR_VERSION* ]]; then echo "${STUB_CONNECTOR-1.6.0}";
    elif [[ -n "${STUB_US_MISSING:-}" ]]; then echo no; else echo yes; fi ;;
  pm:enable) exit "${STUB_ENABLE_RC:-0}" ;;
  upgrade_status:analyze) echo 'analysis output'; exit "${STUB_ANALYZE_RC:-0}" ;;
  sentinel_connector:upgrade-status)
    if [[ "${SENTINEL_SCAN_KEY:-}" == sk_scan_* ]]; then echo "report env key=set uuid=$SENTINEL_CONNECTOR_SITE_UUID api=$SENTINEL_CONNECTOR_API_BASE_URL" >> "$STUB_LOG"; fi
    exit "${STUB_REPORT_RC:-0}" ;;
esac
